<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <!-- Data -->
        <entry name="binaryPath" type="String"><default>bingofuel</default></entry>
        <entry name="pollInterval" type="Int"><default>900</default></entry>
        <entry name="activityCheckInterval" type="Int"><default>10</default></entry>
        <!-- Rings -->
        <entry name="layoutMode" type="String"><default>grid</default></entry>
        <entry name="gaugeLabel" type="String"><default>percent</default></entry>
        <entry name="showHeadings" type="Bool"><default>true</default></entry>
        <entry name="warningThreshold" type="Int"><default>80</default></entry>
        <entry name="criticalThreshold" type="Int"><default>95</default></entry>
        <entry name="currencySymbol" type="String"><default>$</default></entry>
        <entry name="backgroundOpacity" type="Int"><default>55</default></entry>
        <!-- Colours: one per provider, every ring in its group -->
        <entry name="colorClaude" type="String"><default>#D77757</default></entry>
        <entry name="colorCodex" type="String"><default>#FFFFFF</default></entry>
        <entry name="colorCursor" type="String"><default>#3CCFB4</default></entry>
        <entry name="colorOpenrouter" type="String"><default>#7AB8FF</default></entry>
        <entry name="colorTypesafe" type="String"><default>#D45BB6</default></entry>
        <entry name="warningColor" type="String"><default>#E5C07B</default></entry>
        <entry name="criticalColor" type="String"><default>#E06C75</default></entry>
    </group>
</kcfg>
